export BILIBILI_VOICE_ROOT="/root/autodl-tmp/bilibili-voice"
export STYLE_BERT_VITS2_ROOT="${BILIBILI_VOICE_ROOT}/src/Style-Bert-VITS2"
export STYLE_BERT_VITS2_VENV="${BILIBILI_VOICE_ROOT}/envs/style-bert-vits2"
export STYLE_BERT_VITS2_DATASET="${BILIBILI_VOICE_ROOT}/datasets/haibara_jp"
export STYLE_BERT_VITS2_OUTPUT="${BILIBILI_VOICE_ROOT}/outputs/style-bert-vits2"

export HF_HOME="${BILIBILI_VOICE_ROOT}/cache/huggingface"
export HUGGINGFACE_HUB_CACHE="${HF_HOME}/hub"
export TORCH_HOME="${BILIBILI_VOICE_ROOT}/cache/torch"
export PYANNOTE_CACHE="${BILIBILI_VOICE_ROOT}/cache/pyannote"
export PIP_CACHE_DIR="${BILIBILI_VOICE_ROOT}/cache/pip"
export UV_CACHE_DIR="${BILIBILI_VOICE_ROOT}/cache/uv"
export XDG_CACHE_HOME="${BILIBILI_VOICE_ROOT}/cache/xdg"
export MPLCONFIGDIR="${BILIBILI_VOICE_ROOT}/cache/matplotlib"
export TMPDIR="${BILIBILI_VOICE_ROOT}/tmp/style-bert-vits2"

# pyannote 3.x loads its official legacy Lightning checkpoint without passing
# weights_only. PyTorch 2.6+ defaults that argument to true, so retain the
# legacy behavior only inside this isolated training environment.
export TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD="1"

export PATH="${STYLE_BERT_VITS2_VENV}/bin:${PATH}"
